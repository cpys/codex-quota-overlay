<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Keep empty for local/source builds. Set only to the reviewed HTTPS heartbeat endpoint. -->
    <add key="TelemetryEndpoint" value="" />
  </appSettings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
