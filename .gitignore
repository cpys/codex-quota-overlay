# Build outputs
/artifacts/
/build/
/node_modules/
/bin/
/obj/
/.vs/

# Local settings and logs
*.user
*.suo
*.log

# Development screenshots (the curated screenshot lives under docs/images)
/*.png

# Telemetry worker
/telemetry/worker/node_modules/
/telemetry/worker/.wrangler/
/telemetry/worker/wrangler.jsonc
*.dev.vars

# OS/editor files
.DS_Store
Thumbs.db

# Source-controlled generated application icon used by all package builders
!/build/
/build/*
!/build/resources/
/build/resources/*
!/build/resources/icon.png
!/build/resources/tray-template.png
